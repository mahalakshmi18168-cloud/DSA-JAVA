class Solution {
    public int findKRotation(ArrayList<Integer> nums) {
        for(int i=0;i<nums.size()-1;i++){
            if(nums.get(i)>nums.get(i+1)){
                return i+1;
            }
        }
        return 0;
    }
}

using binary search

class Solution {
    public int findKRotation(ArrayList<Integer> nums) {
        int low=0;
        int high=nums.size()-1;
        while(low<=high){
            int mid=(low+high)/2;
       
            if(nums.get(mid)>nums.get(mid+1)){
                return mid+1;
            }
        }
        return 0;
    }
}
