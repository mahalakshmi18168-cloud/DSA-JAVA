class Solution {
    public int[] getFloorAndCeil(int[] nums, int x) {
       int low=0;
       int high=nums.length-1;
       int floor=-1;
       int ceil=-1;
       while(low<=high){
        int mid=(low+high)/2;
        if(nums[mid]==x){
            floor=nums[mid];
            ceil=nums[mid];
            break;
        }
        else if(nums[mid]>x){
            ceil=nums[mid];
            high=mid-1;
        }else if(nums[mid]<x){
            floor=nums[mid];
            low=mid+1;
        }
       }
       return new int[] {floor,ceil};
    }
}
